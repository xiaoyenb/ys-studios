# API 服务（独立部署）
PORT=3001

# 首次启动创建的管理员；创建后请立即登录后台修改密码
YS_ADMIN_USER=admin
YS_ADMIN_PASSWORD=YSstudio@2026

# 可选：只允许这些 IP 访问 /api/admin（逗号分隔，支持 IPv4/IPv6）
# 配置后请确认自己当前公网 IP 在列表里，否则会无法登录后台
ADMIN_ALLOWED_IPS=

# SQLite 数据文件
YS_DB_PATH=./data/ys-studio.db

# 允许访问 API 的前端源（逗号分隔）
CLIENT_ORIGIN=http://localhost:5173

# 上传 Logo 时返回的可访问地址（生产环境填写公网 API 或站点域名）
PUBLIC_API_URL=http://localhost:3001

NODE_ENV=production
