{
  "name": "ys-studio-assistant",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node --watch server/index.js",
    "dev:all": "node server/index.js & vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:server": "esbuild server/index.js --bundle --platform=node --format=esm --target=node24 --outfile=server-dist/index.js --minify --external:express",
    "start": "node server/index.js",
    "start:bundled": "node server-dist/index.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "express": "^5.1.0",
    "katex": "^0.16.25",
    "lucide-react": "^0.544.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "vite": "^7.1.7"
  }
}
